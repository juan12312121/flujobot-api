PORT=3300
# Atlas → Connect → Drivers. Pon el nombre de la base (flujobot) antes del "?"
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/flujobot?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
CORS_ORIGEN=http://localhost:4400

# URL con la que n8n alcanza esta API
API_URL_PUBLICA=http://localhost:3300

# n8n (opcional): sin esto "Publicar" solo genera el JSON para importarlo a mano
N8N_URL=
N8N_API_KEY=
N8N_EVOLUTION_CREDENCIAL_ID=

# Evolution API (opcional): para conectar WhatsApp con QR desde el panel
EVOLUTION_URL=
EVOLUTION_API_KEY=

# Asistente de IA (opcional): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Solo modelos gratuitos (:free), en orden de preferencia; si uno está saturado se usa el siguiente
OPENROUTER_MODELOS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free,openrouter/free
